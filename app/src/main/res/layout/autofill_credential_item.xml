<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vault_black"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:theme="@style/Theme.OfflineVault.AutofillRow">

    <TextView
        android:id="@+id/autofill_credential_title"
        style="@style/AutofillTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
         android:text="@string/autofill_credential_placeholder_title" />

    <TextView
        android:id="@+id/autofill_credential_username"
        style="@style/AutofillValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
         android:text="@string/autofill_credential_placeholder_username" />
</LinearLayout>
